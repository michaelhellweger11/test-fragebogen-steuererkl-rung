import React, { useState, useEffect } from 'react';
import { 
  ChevronRight, 
  ChevronLeft, 
  Upload, 
  CheckCircle, 
  Info, 
  Plus, 
  Trash2, 
  FileText,
  Home,
  Users,
  Stethoscope,
  Briefcase,
  Zap,
  TrendingUp,
  Pill,
  HeartPulse,
  ShieldCheck,
  Building,
  Lock,
  FileSignature
} from 'lucide-react';

const App = () => {
  const [currentStep, setCurrentStep] = useState(0);
  
  // Farben basierend auf dem Kanzlei-Logo (Petrol/Dunkelgrün)
  const brandColors = {
    primary: '#1c5e52', // Das Petrol aus dem Logo-Schwung
    primaryLight: '#e8f2f0',
    text: '#4a4a4a'
  };

  const [formData, setFormData] = useState({
    fullName: '',
    email: '',
    phone: '',
    address: '',
    idCard: null,
    residenceChanged: 'nein',
    residenceDoc: null,
    civilStatus: 'ledig',
    children: [],
    
    // Pflichtfelder Rechtliches
    privacyAccepted: false,
    authenticityConfirmed: false,
    
    cuDoc: null,
    inpsDoc: null,
    gseIncome: 'nein',

    propertyChanges: 'nein',
    propertyContract: null,
    landRegistry: null,
    rentalIncome: 'nein',
    rentalContract: null,

    medicalExpenses: 'nein',
    medicalReceipts: null,
    pharmacyExpenses: 'nein',
    pharmacyReceipts: null,
    pensionFund: 'nein',
    pensionDoc: null,
    insuranceLife: 'nein',
    insuranceDoc: null,

    schoolFees: 'nein',
    schoolReceipts: null
  });

  const steps = [
    { id: 'anagrafik', title: 'Persönliches', icon: <Users className="w-5 h-5" /> },
    { id: 'einkommen', title: 'Einkommen', icon: <TrendingUp className="w-5 h-5" /> },
    { id: 'immobilien', title: 'Besitz & Mieten', icon: <Home className="w-5 h-5" /> },
    { id: 'spesen', title: 'Spesen & Vorsorge', icon: <Stethoscope className="w-5 h-5" /> },
    { id: 'kinder', title: 'Familie & Kinder', icon: <Users className="w-5 h-5" /> },
    { id: 'review', title: 'Abschluss', icon: <CheckCircle className="w-5 h-5" /> }
  ];

  const handleInputChange = (e) => {
    const { name, value, type, checked } = e.target;
    setFormData(prev => ({
      ...prev,
      [name]: type === 'checkbox' ? checked : value
    }));
  };

  const handleFileUpload = (name, files) => {
    setFormData(prev => ({
      ...prev,
      [name]: files[0]
    }));
  };

  const FileUploadField = ({ label, name, condition = true, info }) => {
    if (!condition) return null;
    return (
      <div className="mt-3 p-4 border-2 border-dashed border-gray-200 rounded-xl bg-gray-50 hover:border-teal-600 transition-colors">
        <label className="block mb-2 text-sm font-semibold text-gray-700">
          {label} {info && <span className="font-normal text-xs text-gray-500 italic">({info})</span>}
        </label>
        <div className="flex items-center gap-4">
          <label 
            className="flex items-center justify-center px-4 py-2 bg-white border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-50 text-sm font-medium text-gray-700 shadow-sm transition-all"
            style={{ borderColor: formData[name] ? brandColors.primary : undefined }}
          >
            <Upload className="w-4 h-4 mr-2" style={{ color: brandColors.primary }} />
            Datei auswählen
            <input type="file" className="hidden" onChange={(e) => handleFileUpload(name, e.target.files)} />
          </label>
          {formData[name] && (
            <span className="text-sm flex items-center gap-1 font-medium truncate max-w-[200px]" style={{ color: brandColors.primary }}>
              <CheckCircle className="w-4 h-4 shrink-0" /> {formData[name].name || 'Bereit'}
            </span>
          )}
        </div>
      </div>
    );
  };

  // Prüfung ob aktueller Schritt valide ist
  const isStepValid = () => {
    if (currentStep === 0) {
      return (
        formData.fullName.trim() !== '' && 
        formData.email.trim() !== '' && 
        formData.privacyAccepted && 
        formData.authenticityConfirmed
      );
    }
    return true;
  };

  const renderStepContent = () => {
    switch (currentStep) {
      case 0:
        return (
          <div className="space-y-6 animate-in fade-in slide-in-from-right-4">
            <h2 className="text-2xl font-bold text-gray-800">Anagrafische Daten</h2>
            
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium mb-1">Vor- und Nachname *</label>
                <input name="fullName" value={formData.fullName} onChange={handleInputChange} className="w-full p-2 border rounded-lg focus:ring-2 outline-none" style={{ '--tw-ring-color': brandColors.primary }} placeholder="Max Mustermann" />
              </div>
              <div>
                <label className="block text-sm font-medium mb-1">E-Mail Adresse *</label>
                <input name="email" value={formData.email} onChange={handleInputChange} className="w-full p-2 border rounded-lg focus:ring-2 outline-none" style={{ '--tw-ring-color': brandColors.primary }} placeholder="max@beispiel.de" />
              </div>
            </div>

            <FileUploadField label="Kopie des gültigen Ausweises" name="idCard" info="Personalausweis oder Reisepass" />

            <div className="p-4 rounded-xl" style={{ backgroundColor: brandColors.primaryLight }}>
              <p className="text-sm font-medium mb-3" style={{ color: brandColors.primary }}>Änderung des Wohnsitzes im Jahr 2024 oder 2025?</p>
              <div className="flex gap-4">
                {['ja', 'nein'].map(opt => (
                  <label key={opt} className="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="residenceChanged" value={opt} checked={formData.residenceChanged === opt} onChange={handleInputChange} className="w-4 h-4" style={{ color: brandColors.primary }} />
                    <span className="capitalize">{opt}</span>
                  </label>
                ))}
              </div>
              <FileUploadField label="Meldung an die Gemeinde" name="residenceDoc" condition={formData.residenceChanged === 'ja'} />
            </div>

            {/* Rechtliche Bestätigungen */}
            <div className="space-y-4 pt-4 border-t border-gray-100">
              <div className={`p-4 rounded-xl border-2 transition-all ${formData.privacyAccepted ? 'bg-white border-teal-100' : 'bg-red-50 border-red-100'}`}>
                <label className="flex items-start gap-3 cursor-pointer">
                  <div className="pt-1">
                    <input 
                      type="checkbox" 
                      name="privacyAccepted" 
                      checked={formData.privacyAccepted} 
                      onChange={handleInputChange} 
                      className="w-5 h-5 rounded" 
                      style={{ color: brandColors.primary }}
                    />
                  </div>
                  <div className="text-sm leading-relaxed">
                    <span className="font-bold block flex items-center gap-1">
                      <Lock size={14} style={{ color: brandColors.primary }} /> Datenschutz-Einwilligung *
                    </span>
                    Ich bestätige, dass ich die Datenschutzbestimmungen gelesen habe und mit der Verarbeitung meiner personenbezogenen Daten zum Zweck der Steuererklärung einverstanden bin.
                  </div>
                </label>
              </div>

              <div className={`p-4 rounded-xl border-2 transition-all ${formData.authenticityConfirmed ? 'bg-white border-teal-100' : 'bg-red-50 border-red-100'}`}>
                <label className="flex items-start gap-3 cursor-pointer">
                  <div className="pt-1">
                    <input 
                      type="checkbox" 
                      name="authenticityConfirmed" 
                      checked={formData.authenticityConfirmed} 
                      onChange={handleInputChange} 
                      className="w-5 h-5 rounded" 
                      style={{ color: brandColors.primary }}
                    />
                  </div>
                  <div className="text-sm leading-relaxed">
                    <span className="font-bold block flex items-center gap-1">
                      <FileSignature size={14} style={{ color: brandColors.primary }} /> Bestätigung der Echtheit *
                    </span>
                    Ich bestätige hiermit die Richtigkeit und Echtheit aller hochgeladenen Dokumente. Mir ist bewusst, dass nur Belege für tatsächlich getätigte Ausgaben zur Absetzbarkeit eingereicht werden dürfen.
                  </div>
                </label>
              </div>
              <p className="text-[10px] text-gray-400 italic">* Pflichtfelder zum Fortfahren</p>
            </div>
          </div>
        );
      case 1:
        return (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold text-gray-800">Einkommen 2024</h2>
            <div className="p-4 border border-gray-200 rounded-xl">
              <h3 className="font-semibold flex items-center gap-2 mb-4"><FileText style={{ color: brandColors.primary }} /> Bescheinigungen</h3>
              <FileUploadField label="Mod. CU/2025 hochladen" name="cuDoc" />
              <FileUploadField label="Mod. CU/2025 INPS hochladen" name="inpsDoc" />
            </div>
          </div>
        );
      case 2:
        return (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold text-gray-800">Immobilien & Besitz</h2>
            <div className="bg-amber-50 border border-amber-200 p-4 rounded-xl flex gap-3">
              <Info className="text-amber-600 shrink-0" />
              <p className="text-sm text-amber-800">Haben Sie im Jahr 2024 Immobilien an- oder verkauft oder gab es Änderungen am Besitzstand?</p>
            </div>
            <div className="flex gap-4 p-2">
              {['ja', 'nein'].map(opt => (
                <label key={opt} className={`flex items-center gap-2 cursor-pointer bg-white px-6 py-3 border rounded-xl shadow-sm transition-all ${formData.propertyChanges === opt ? 'border-teal-600 ring-1 ring-teal-600' : 'hover:border-teal-400'}`}>
                  <input type="radio" name="propertyChanges" value={opt} checked={formData.propertyChanges === opt} onChange={handleInputChange} />
                  <span className="font-bold uppercase text-gray-700">{opt}</span>
                </label>
              ))}
            </div>
            {formData.propertyChanges === 'ja' && (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 animate-in zoom-in-95">
                <FileUploadField label="Kauf- oder Verkaufvertrag" name="propertyContract" />
                <FileUploadField label="Aktueller Katasterauszug" name="landRegistry" />
              </div>
            )}
          </div>
        );
      case 3:
        return (
          <div className="space-y-6 animate-in fade-in">
            <h2 className="text-2xl font-bold text-gray-800">Spesen & Vorsorge</h2>
            
            <div className="p-5 border border-gray-200 rounded-2xl bg-white shadow-sm">
              <div className="flex items-center gap-3 mb-4">
                <div className="p-2 bg-red-50 text-red-600 rounded-lg"><HeartPulse className="w-5 h-5" /></div>
                <div>
                  <h3 className="font-bold text-gray-800">Arztspesen</h3>
                  <p className="text-xs text-red-600 font-medium italic">Spesen müssen im Bezugsjahr 2024 bezahlt worden sein!</p>
                </div>
              </div>
              <label className="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="medicalExpenses" checked={formData.medicalExpenses === true} onChange={(e) => setFormData(p => ({...p, medicalExpenses: e.target.checked}))} className="w-5 h-5 rounded" style={{ color: brandColors.primary }} />
                <span className="text-sm font-medium">Haben Sie Arztbelege?</span>
              </label>
              <FileUploadField label="Sammelbeleg Arztspesen" name="medicalReceipts" condition={formData.medicalExpenses} />
            </div>

            <div className="p-5 border border-gray-200 rounded-2xl bg-white shadow-sm">
              <div className="flex items-center gap-3 mb-4">
                <div className="p-2 bg-green-50 text-green-600 rounded-lg"><Pill className="w-5 h-5" /></div>
                <h3 className="font-bold text-gray-800">Apothekenrechnungen</h3>
              </div>
              <label className="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="pharmacyExpenses" checked={formData.pharmacyExpenses === true} onChange={(e) => setFormData(p => ({...p, pharmacyExpenses: e.target.checked}))} className="w-5 h-5 rounded" />
                <span className="text-sm font-medium">Belege der Apotheke vorhanden?</span>
              </label>
              <FileUploadField label="Apothekenbelege" name="pharmacyReceipts" condition={formData.pharmacyExpenses} />
            </div>

            <div className="p-5 border border-gray-200 rounded-2xl bg-white shadow-sm">
              <div className="flex items-center gap-3 mb-4">
                <div className="p-2 bg-blue-50 text-blue-600 rounded-lg"><ShieldCheck className="w-5 h-5" /></div>
                <h3 className="font-bold text-gray-800">Einzahlung Pensionsfond</h3>
              </div>
              <label className="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="pensionFund" checked={formData.pensionFund === true} onChange={(e) => setFormData(p => ({...p, pensionFund: e.target.checked}))} className="w-5 h-5 rounded" />
                <span className="text-sm font-medium">Beiträge in Pensionsfond eingezahlt?</span>
              </label>
              <FileUploadField label="Einzahlungsbestätigung" name="pensionDoc" condition={formData.pensionFund} />
            </div>
          </div>
        );
      case 5:
        return (
          <div className="text-center py-12 space-y-6">
            <div className="inline-flex items-center justify-center w-20 h-20 bg-teal-50 rounded-full mb-4" style={{ color: brandColors.primary }}>
              <CheckCircle className="w-10 h-10" />
            </div>
            <h2 className="text-3xl font-bold text-gray-800">Übermittlung bereit</h2>
            <p className="text-gray-600 max-w-md mx-auto italic">Vielen Dank für die digitale Bereitstellung Ihrer Unterlagen für Mutschlechner & Hellweger.</p>
            <button className="text-white px-8 py-4 rounded-xl font-bold shadow-lg transition-all transform hover:scale-105" style={{ backgroundColor: brandColors.primary }}>
              JETZT UNTERLAGEN ÜBERMITTELN
            </button>
          </div>
        );
      default:
        return <div className="p-10 text-center text-gray-400">Abschnitt in Kürze verfügbar...</div>;
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 text-gray-900 font-sans p-4 md:p-8">
      <div className="max-w-5xl mx-auto">
        {/* Header mit Logo */}
        <div className="flex flex-col md:flex-row md:items-start justify-between mb-10 gap-6">
          <div className="pt-2">
            <h1 className="text-4xl font-black tracking-tight" style={{ color: brandColors.primary }}>STEUERJAHR 2024</h1>
            <p className="text-gray-500 font-medium mt-1">Ihr digitales Portal zur Steuererklärung</p>
          </div>
          <div className="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-end">
            <img 
              src="https://raw.githubusercontent.com/Mutschlechner-Hellweger/assets/main/logo.png" 
              alt="Mutschlechner & Hellweger Logo" 
              className="h-16 object-contain"
              onError={(e) => {
                e.target.style.display = 'none';
                e.target.parentNode.innerHTML += '<div class="font-bold text-xl text-teal-800">MUTSCHLECHNER & HELLWEGER</div><div class="text-[10px] text-gray-500 text-right">WIRTSCHAFTSPRÜFER | STEUERBERATER</div>';
              }}
            />
          </div>
        </div>

        {/* Navigation */}
        <div className="hidden md:flex justify-between mb-10 relative px-4">
          <div className="absolute top-5 left-8 right-8 h-0.5 bg-gray-200 -z-10"></div>
          {steps.map((step, idx) => (
            <div key={step.id} className="flex flex-col items-center gap-2 group">
              <div 
                className={`w-11 h-11 rounded-full flex items-center justify-center border-2 transition-all shadow-sm ${
                  idx < currentStep ? 'bg-teal-700 border-teal-700 text-white' : 
                  idx === currentStep ? 'bg-white border-teal-700 ring-4 ring-teal-50' : 
                  'bg-white border-gray-200 text-gray-400'
                }`}
                style={{ 
                  borderColor: (idx <= currentStep) ? brandColors.primary : undefined,
                  backgroundColor: (idx < currentStep) ? brandColors.primary : undefined,
                  color: (idx === currentStep) ? brandColors.primary : undefined
                }}
              >
                {idx < currentStep ? <CheckCircle className="w-6 h-6" /> : step.icon}
              </div>
              <span className={`text-[10px] font-bold uppercase tracking-wider transition-colors ${idx <= currentStep ? 'text-teal-900' : 'text-gray-400'}`}>
                {step.title}
              </span>
            </div>
          ))}
        </div>

        {/* Dashboard Card */}
        <div className="bg-white rounded-[2rem] shadow-2xl shadow-teal-900/5 border border-gray-100 overflow-hidden min-h-[580px] flex flex-col">
          <div className="p-6 md:p-12 flex-grow">
            {renderStepContent()}
          </div>

          {/* Footer Controls */}
          <div className="p-6 bg-gray-50 border-t flex justify-between items-center">
            <button 
              onClick={() => setCurrentStep(prev => Math.max(0, prev - 1))} 
              disabled={currentStep === 0} 
              className={`flex items-center gap-2 px-6 py-3 rounded-xl font-bold transition-all ${currentStep === 0 ? 'opacity-0' : 'text-gray-600 hover:bg-gray-200'}`}
            >
              <ChevronLeft className="w-5 h-5" /> Zurück
            </button>
            <div className="text-xs font-bold text-gray-400 uppercase tracking-widest hidden sm:block">
              Seite {currentStep + 1} von {steps.length}
            </div>
            <button 
              onClick={() => {
                if(isStepValid()) {
                  setCurrentStep(prev => Math.min(steps.length - 1, prev + 1));
                }
              }} 
              disabled={currentStep === steps.length - 1 || !isStepValid()} 
              className={`flex items-center gap-2 px-8 py-3 rounded-xl font-bold text-white shadow-lg hover:brightness-110 transition-all disabled:opacity-50 disabled:cursor-not-allowed disabled:grayscale ${currentStep === steps.length - 1 ? 'hidden' : ''}`}
              style={{ backgroundColor: brandColors.primary }}
            >
              Weiter <ChevronRight className="w-5 h-5" />
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

export default App;
